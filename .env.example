# App's own base URL — exposed to the browser (NEXT_PUBLIC_) since the
# client fetch helper (lib/apiClient.js) prefixes every API call with it.
NEXT_PUBLIC_BASE_URL=http://localhost:3009

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/visitor-management

# Secret used to sign/verify admin JWTs — use a long random string in production
JWT_SECRET=replace-with-a-long-random-secret

# Admin login credentials
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD must be a bcrypt hash, not plain text.
# Generate one with: node -e "console.log(require('bcrypt').hashSync('yourPassword', 10))"
# Escape every "$" as "\$" — Next.js expands unescaped "$word" in .env files
# as a variable reference, which corrupts bcrypt hashes (they're full of "$").
ADMIN_PASSWORD=\$2b\$10\$replace.with.a.bcrypt.hash.................................
